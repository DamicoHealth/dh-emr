node_modules/
dist/
dist-*/
.DS_Store
*.log
.env
.env.*

# Patient data exports never enter git. Never open this directory.
exports/

# Demo build output: regenerated by "npm run build:demos" at deploy time.
# Only the hand-written demo hub (demo/index.html) is tracked; everything
# else under demo/ is build output.
packages/site/public/demo/*
!packages/site/public/demo/index.html
# Kill switch for the old site's demo worker (see the file's comment).
!packages/site/public/demo/sw.js

# Product app build output: regenerated by build:field / build:clinic at deploy time.
packages/site/public/field/
packages/site/public/clinic/
