node_modules/
dist/
dist-*/
.DS_Store
*.log
.env
.env.*

# Patient data exports never enter git. Never open this directory.
exports/

# Demo build output: regenerated by "npm run build:demos" at deploy time.
# The demo hub (demo/index.html) and the Clinic demo placeholder
# (demo/clinic/index.html, replaced by the Clinic build when it ships) are
# hand-written and tracked; everything else under demo/ is build output.
packages/site/public/demo/*
!packages/site/public/demo/index.html
!packages/site/public/demo/clinic/
packages/site/public/demo/clinic/*
!packages/site/public/demo/clinic/index.html

# Product app build output (deploy builds land here; the placeholder index.html pages stay tracked).
packages/site/public/field/*
!packages/site/public/field/index.html
packages/site/public/clinic/*
!packages/site/public/clinic/index.html
