{
  "name": "dh-emr",
  "version": "0.1.0",
  "private": true,
  "description": "DH EMR - free, offline-first EMR for global-health clinics. One app, two modes: connected clinic and offline field.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @dh/app run dev",
    "build": "npm --workspace @dh/app run build",
    "test": "npm --workspace @dh/app run test",
    "test:watch": "npm --workspace @dh/app run test:watch",
    "typecheck": "npm --workspace @dh/app run typecheck"
  }
}
