{
  "name": "@dh/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DH EMR shared core: kernel, domain, config, sync, auth, UI kit, and the executable spec (test suite). Consumed by the Field and Clinic apps through the @dh/core/* path alias.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "DH_SLOW_IO=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
