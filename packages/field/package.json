{
  "name": "@dh/field",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DH EMR Field: offline paper-chart entry for outreach clinics. No user accounts (the device is the identity); standalone or shared-key cloud sync. A thin PWA shell over @dh/core.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=/field/ --outDir=../site/public/field --emptyOutDir",
    "build:demo": "DH_DEMO=1 DH_STORAGE_SUFFIX=-demo vite build --base=/demo/field/ --outDir=../site/public/demo/field --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:slow": "DH_SLOW_IO=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:local": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
